    function speakText(text, mode, onFinished) {
      if (!('speechSynthesis' in window)) {
        showToast('此瀏覽器暫不支援語音朗讀，改用自動翻頁模式');
        if (typeof onFinished === 'function') {
          autoNextTimer = setTimeout(onFinished, 4500);
        }
        return;
      }
      if (speakTimer) clearTimeout(speakTimer);
      if (autoNextTimer) clearTimeout(autoNextTimer);
      window.speechSynthesis.cancel();
      try { window.speechSynthesis.resume(); } catch (e) {}

      const voices = refreshVoices();
      const chosen = getSelectedVoice(mode);

      if (mode === 'zh-HK' && !chosen && voices.length > 0) {
        showToast('此瀏覽器未找到香港廣東話語音，點「🎙️」可查看啟用方法');
      }

      const utter = new SpeechSynthesisUtterance(text);
      // Pin utterance globally so Chrome does not garbage-collect it before onend fires
      window.__activeUtterance = utter;

      if (chosen) {
        utter.voice = chosen;
        utter.lang = chosen.lang;
      } else {
        utter.lang = mode === 'zh-HK' ? 'zh-HK' : 'zh-TW';
      }
      utter.rate = slowSpeed ? 0.88 : 1.02;
      utter.pitch = 1.05;

      let finishedOnce = false;
      const done = () => {
        if (finishedOnce) return;
        finishedOnce = true;
        window.__activeUtterance = null;
        isSpeaking = false;
        updateSpeechButtons();
        if (typeof onFinished === 'function') onFinished();
      };

      utter.onstart = () => {
        isSpeaking = true;
        updateSpeechButtons();
      };
      utter.onend = done;
      utter.onerror = (ev) => {
        if (ev && ev.error === 'interrupted') return;
        isSpeaking = false;
        isAutoPlaying = false;
        playAllQueue = false;
        releaseWakeLock();
        updateSpeechButtons();
      };

      isSpeaking = true;
      updateSpeechButtons();

      speakTimer = setTimeout(() => {
        try { window.speechSynthesis.resume(); } catch (e) {}
        window.speechSynthesis.speak(utter);
      }, 80);
    }

    function speakCurrentPage(continueAuto) {
      if (!currentBook) return;
      if (continueAuto) requestWakeLock();
      const page = currentBook.pages[currentPage];
      const onPageAudioDone = () => {
        if (continueAuto && isAutoPlaying && currentBook) {
          if (currentPage < currentBook.pages.length - 1) {
            autoNextTimer = setTimeout(() => {
              if (!isAutoPlaying) return;
              direction = 'next';
              currentPage += 1;
              renderReaderPage();
              speakCurrentPage(true);
            }, 1100);
          } else {
            markBookRead(currentBook.id);
            if (playAllQueue) {
              const all = getAllStories();
              const idx = all.findIndex(b => b.id === currentBook.id);
              if (idx >= 0 && idx < all.length - 1) {
                const nextBook = all[idx + 1];
                showToast(`✨ 即將接播下一本：《${nextBook.title}》`);
                autoNextTimer = setTimeout(() => {
                  if (!isAutoPlaying) return;
                  currentBook = nextBook;
                  currentPage = 0;
                  direction = 'next';
                  if (!completedStepsByBook[nextBook.id]) completedStepsByBook[nextBook.id] = {};
                  readerBookTitle.textContent = nextBook.title;
                  renderReaderPage();
                  speakCurrentPage(true);
                }, 1600);
                return;
              }
            }
            isAutoPlaying = false;
            playAllQueue = false;
            releaseWakeLock();
            updateSpeechButtons();
            showToast('🎉 故事全部講完啦！');
            if (typeof confetti === 'function') {
              confetti({ particleCount: 65, spread: 65, origin: { y: 0.7 } });
            }
          }
        }
      };

      // Priority 1: Play Dad/Mom's real recorded or uploaded audio if available!
      const savedClip = getVoiceClip(currentBook.id, currentPage);
      if (savedClip) {
        if (speakTimer) clearTimeout(speakTimer);
        if (autoNextTimer) clearTimeout(autoNextTimer);
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        if (activeAudioEl) {
          try { activeAudioEl.pause(); } catch (e) {}
          activeAudioEl = null;
        }
        const audio = new Audio(savedClip);
        activeAudioEl = audio;
        isSpeaking = true;
        updateSpeechButtons();
        if (isAutoPlaying && autoPlayBannerText) {
          autoPlayBannerText.textContent = playAllQueue
            ? '💖 正在播放真人配音（連播模式）· 播完自動翻頁'
            : '💖 正在播放真人配音 · 播完自動翻下一頁';
        }
        audio.onended = () => {
          activeAudioEl = null;
          isSpeaking = false;
          updateSpeechButtons();
          onPageAudioDone();
        };
        audio.onerror = () => {
          activeAudioEl = null;
          isSpeaking = false;
          updateSpeechButtons();
          showToast('真人音檔播放失敗，改用系統語音朗讀');
          const text = speechLang === 'zh-HK' ? (page.speakTextHK || page.speakText) : page.speakText;
          speakText(text, speechLang, onPageAudioDone);
        };
        audio.play().catch(() => {
          activeAudioEl = null;
          isSpeaking = false;
          updateSpeechButtons();
          showToast('請點擊播放按鈕以啟動聲音');
        });
        return;
      }

      // Priority 2: System Cantonese / Mandarin TTS
      const text = speechLang === 'zh-HK' ? (page.speakTextHK || page.speakText) : page.speakText;
      speakText(text, speechLang, onPageAudioDone);
    }

