          const idx = Number(el.getAttribute('data-idx'));
          const field = el.getAttribute('data-field');
          draftPages[idx][field] = el.value;
        });
      });
      newPagesContainer.querySelectorAll('.draft-file').forEach(el => {
        el.addEventListener('change', async () => {
          const idx = Number(el.getAttribute('data-idx'));
          if (el.files && el.files[0]) {
            draftPages[idx].img = await readImageAsCompressedDataUrl(el.files[0]);
          }
        });
      });
      newPagesContainer.querySelectorAll('.rm-draft-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          draftPages.splice(Number(btn.getAttribute('data-rm')), 1);
          renderDraftPages();
        });
      });
    }

    function openAddStoryModal() {
      newTitle.value = '';
      newSubtitle.value = '';
      newCoverFile.value = '';
      draftPages = [
        { title: '故事開始', text: '', tip: '', img: '' },
        { title: '學到好習慣', text: '', tip: '', img: '' }
      ];
      renderDraftPages();
      addStoryModal.classList.remove('hidden');
      addStoryModal.classList.add('flex');
    }

    function closeAddStoryModal() {
      addStoryModal.classList.add('hidden');
      addStoryModal.classList.remove('flex');
    }

    btnAddPageRow.addEventListener('click', () => {
      draftPages.push({ title: `第 ${draftPages.length + 1} 頁`, text: '', tip: '', img: '' });
      renderDraftPages();
    });

    btnSaveNewStory.addEventListener('click', async () => {
      const title = newTitle.value.trim();
      if (!title) {
        showToast('請先輸入故事書名！');
        return;
      }
      const validPages = draftPages.filter(p => p.text.trim() || p.title.trim());
      if (validPages.length === 0) {
        showToast('請至少填寫一頁故事內容！');
        return;
      }

      let coverImg = '';
      if (newCoverFile.files && newCoverFile.files[0]) {
        coverImg = await readImageAsCompressedDataUrl(newCoverFile.files[0]);
      } else {
        coverImg = validPages[0].img || makeDefaultCoverSvg(title);
      }

      const subtitle = newSubtitle.value.trim() || '爸爸媽媽新增的專屬故事';
      const builtPages = [
        {
          isCover: true,
          badge: '封面',
          title: title,
          subtitle: subtitle,
          img: coverImg,
          stickers: ['✨', '🌟'],
          speakTextHK: `${title}。${subtitle}。翻開下一頁一齊聽故事啦！`,
          speakText: `${title}。${subtitle}。翻開下一頁一起聽故事吧！`
        },
        ...validPages.map((p, i) => ({
          badge: `第 ${i + 1} 頁`,
          chapterTag: `第 ${i + 1} 頁`,
          tagColor: 'bg-amber-100 text-amber-800',
          title: p.title.trim() || `第 ${i + 1} 頁`,
          img: p.img || coverImg,
          stickers: ['🌟', '💭'],
          paragraphs: p.text.trim().split(/\n+/).filter(Boolean),
          tipTitle: p.tip.trim() ? '💡 小提醒' : '',
          tipText: p.tip.trim(),
          speakTextHK: `${p.title.trim()}。${p.text.trim()}`,
          speakText: `${p.title.trim()}。${p.text.trim()}`
        }))
      ];

      customStories.unshift({
        id: 'custom-' + Date.now(),
        isCustom: true,
        title,
        subtitle,
        category: newCategory.value,
        emoji: '✨',
        coverImg,
        pages: builtPages
      });
      saveCustomStories();
      closeAddStoryModal();
      activeCategory = '全部';
      renderHome();
      showToast(`✅ 已將《${title}》加入書架！`);
    });

    // ==================== EXPORT / IMPORT BACKUP ====================
    btnExportLib.addEventListener('click', () => {
      const payload = { version: 2, exportedAt: new Date().toISOString(), customStories, voiceClips: voiceClipsCache };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'kids_story_backup.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('📤 已下載故事庫備份檔（可傳給太太匯入）');
    });

    inputImportLib.addEventListener('change', () => {
      const file = inputImportLib.files && inputImportLib.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result);
          const imported = Array.isArray(data) ? data : (data.customStories || []);
          if (!Array.isArray(imported)) throw new Error('bad format');
          const existingIds = new Set(customStories.map(s => s.id));
          let added = 0;
          imported.forEach(s => {
            if (s && s.title && Array.isArray(s.pages) && !existingIds.has(s.id)) {
              s.isCustom = true;
              customStories.push(s);
              added++;
            }
          });
          let clipAdded = 0;
          if (data && data.voiceClips && typeof data.voiceClips === 'object') {
            Object.entries(data.voiceClips).forEach(([k, v]) => {
              if (typeof v === 'string' && v.startsWith('data:audio/')) {
                const parts = k.split('::');
                if (parts.length === 2) {
                  saveVoiceClip(parts[0], Number(parts[1]), v);
                  clipAdded++;
                }
              }
            });
          }
          saveCustomStories();
          renderHome();
          showToast(`📥 成功匯入 ${added} 本故事` + (clipAdded ? `及 ${clipAdded} 段真人配音！` : '！'));
        } catch (e) {
          showToast('匯入失敗：請確認是正確的 JSON 故事備份檔');
        }
        inputImportLib.value = '';
      };
      reader.readAsText(file);
    });

    // ==================== EVENT WIRING ====================
    homeLangHK.addEventListener('click', () => setLanguage('zh-HK'));
    homeLangTW.addEventListener('click', () => setLanguage('zh-TW'));
    langHK.addEventListener('click', () => setLanguage('zh-HK'));
    langTW.addEventListener('click', () => setLanguage('zh-TW'));

    btnOpenAddStory.addEventListener('click', openAddStoryModal);
    btnCloseAddModal.addEventListener('click', closeAddStoryModal);
    btnCancelAddModal.addEventListener('click', closeAddStoryModal);
    addStoryModal.addEventListener('click', (e) => { if (e.target === addStoryModal) closeAddStoryModal(); });

    btnBackHome.addEventListener('click', closeReader);
    btnPrev.addEventListener('click', () => goToPage(currentPage - 1));
    btnNext.addEventListener('click', () => goToPage(currentPage + 1));

    btnPlayAllBooks.addEventListener('click', () => {
      const all = getAllStories();
      if (!all.length) return;
      openBook(all[0].id, false);
      playAllQueue = true;
      isAutoPlaying = true;
      updateSpeechButtons();
      speakCurrentPage(true);
    });

    btnSpeed.addEventListener('click', () => {
      slowSpeed = !slowSpeed;
      btnSpeed.textContent = slowSpeed ? '🐢 慢速' : '🐇 正常';
      showToast(slowSpeed ? '已切換為慢速朗讀（適合幼兒）' : '已切換為正常語速');
      if (isAutoPlaying) speakCurrentPage(true);
      else if (isSpeaking) speakCurrentPage(false);
    });

    btnAutoPlay.addEventListener('click', () => {
      if (isAutoPlaying) {
        stopAllSpeech();
      } else {
        isAutoPlaying = true;
        updateSpeechButtons();
        speakCurrentPage(true);
      }
    });

    btnSpeak.addEventListener('click', () => {
      if (isSpeaking && !isAutoPlaying) {
        stopAllSpeech();
      } else {
        isAutoPlaying = false;
        speakCurrentPage(false);
      }
    });

    btnAnim.addEventListener('click', () => {
      animEnabled = !animEnabled;
      document.body.classList.toggle('no-anim', !animEnabled);
      btnAnim.textContent = animEnabled ? '✨' : '⏸️';
      showToast(animEnabled ? '已開啟圖片微動畫' : '已暫停圖片微動畫');
    });

    function openVoiceModal() {
      refreshVoices();
      voiceModal.classList.remove('hidden');
      voiceModal.classList.add('flex');
    }
    function closeVoiceModal() {
      voiceModal.classList.add('hidden');
      voiceModal.classList.remove('flex');
    }
    btnHomeVoice.addEventListener('click', openVoiceModal);
    btnReaderVoice.addEventListener('click', openVoiceModal);
    btnCloseVoiceModal.addEventListener('click', closeVoiceModal);
    btnDoneVoiceModal.addEventListener('click', closeVoiceModal);
    voiceModal.addEventListener('click', (e) => { if (e.target === voiceModal) closeVoiceModal(); });

    voiceSelect.addEventListener('change', () => {
      manualVoiceURI = voiceSelect.value;
      updateVoiceUI();
    });

    btnTestVoice.addEventListener('click', () => {
      speakText('哈囉！歡迎嚟到寶貝成長有聲繪本館，今日想聽邊個故事呀？', 'zh-HK');
    });

    window.addEventListener('keydown', (e) => {
      if (!currentBook) return;
      if (e.key === 'ArrowRight') {
        if (currentPage < currentBook.pages.length - 1) goToPage(currentPage + 1);
      } else if (e.key === 'ArrowLeft') {
        if (currentPage > 0) goToPage(currentPage - 1);
      } else if (e.key === 'Escape') {
        closeReader();
      }
    });

    let touchStartX = 0;
    bookFrame.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    bookFrame.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(dx) > 50 && currentBook) {
        if (dx < 0 && currentPage < currentBook.pages.length - 1) goToPage(currentPage + 1);
        else if (dx > 0 && currentPage > 0) goToPage(currentPage - 1);
      }
    }, { passive: true });

    // ==================== HUMAN VOICE RECORDER & UPLOADER ====================
    function updateRecordButtonBadge() {
      if (!currentBook) return;
      const hasClip = !!getVoiceClip(currentBook.id, currentPage);
      if (hasClip) {
        btnOpenRecord.classList.remove('bg-rose-50', 'border-rose-200', 'text-rose-700');
        btnOpenRecord.classList.add('bg-rose-500', 'border-rose-500', 'text-white');
        recBtnIcon.textContent = '💖';
        recBtnLabel.textContent = '已錄真人聲';
      } else {
        btnOpenRecord.classList.remove('bg-rose-500', 'border-rose-500', 'text-white');
        btnOpenRecord.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-700');
        recBtnIcon.textContent = '🎙️';
        recBtnLabel.textContent = '爸媽錄音';
      }
    }

    function refreshRecordModalUI() {
      if (!currentBook) return;
      const page = currentBook.pages[currentPage];
      recModalTitle.textContent = `為《${currentBook.title}》錄製真人聲`;
      recPageIndicator.textContent = page.badge || (page.isCover ? '封面' : `第 ${currentPage} 頁`);
      recTeleprompter.textContent = speechLang === 'zh-HK' ? (page.speakTextHK || page.speakText) : page.speakText;

      const existing = getVoiceClip(currentBook.id, currentPage);
      if (existing) {
        recPreviewBox.classList.remove('hidden');
        recAudioPlayer.src = existing;
      } else {
        recPreviewBox.classList.add('hidden');
        recAudioPlayer.removeAttribute('src');
      }
      updateRecordButtonBadge();
    }

    function stopMicRecordingIfActive() {
      if (recInterval) { clearInterval(recInterval); recInterval = null; }
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        try { mediaRecorder.stop(); } catch (e) {}
      }
      micRecIcon.textContent = '🔴';
      micRecLabel.textContent = '開始錄製爸媽聲音';
      btnToggleMicRec.classList.remove('bg-slate-800', 'hover:bg-slate-900');
      btnToggleMicRec.classList.add('bg-rose-500', 'hover:bg-rose-600');
      recTimer.classList.add('hidden');
    }

    function openRecordModal() {
      if (!currentBook) return;
      stopAllSpeech();
      refreshRecordModalUI();
      recordModal.classList.remove('hidden');
      recordModal.classList.add('flex');
    }

    function closeRecordModal() {
      stopMicRecordingIfActive();
      try { recAudioPlayer.pause(); } catch (e) {}
      recordModal.classList.add('hidden');
      recordModal.classList.remove('flex');
    }

    btnOpenRecord.addEventListener('click', openRecordModal);
    btnCloseRecModal.addEventListener('click', closeRecordModal);
    btnDoneRecModal.addEventListener('click', closeRecordModal);
    recordModal.addEventListener('click', (e) => { if (e.target === recordModal) closeRecordModal(); });

    btnToggleMicRec.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        stopMicRecordingIfActive();
        return;
      }
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof MediaRecorder === 'undefined') {
        showToast('此瀏覽器不支援直接錄音，請用下方「📁 選擇音檔」上傳手機錄音檔！');
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        recordedChunks = [];
        const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
          ? 'audio/webm;codecs=opus'
          : (MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4' : '');
        mediaRecorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);

        mediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) recordedChunks.push(e.data);
        };
        mediaRecorder.onstop = () => {
          stream.getTracks().forEach(t => t.stop());
          const blob = new Blob(recordedChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
          const reader = new FileReader();
          reader.onload = async () => {
            if (currentBook && reader.result) {
              await saveVoiceClip(currentBook.id, currentPage, reader.result);
              refreshRecordModalUI();
              showToast('💖 已儲存本頁真人錄音！播故事時會自動播這把聲');
            }
          };
          reader.readAsDataURL(blob);
        };

        mediaRecorder.start();
        recSeconds = 0;
        recTimer.textContent = '00:00';
        recTimer.classList.remove('hidden');
        micRecIcon.textContent = '⏹️';
        micRecLabel.textContent = '停止並儲存錄音';
        btnToggleMicRec.classList.remove('bg-rose-500', 'hover:bg-rose-600');
        btnToggleMicRec.classList.add('bg-slate-800', 'hover:bg-slate-900');

        recInterval = setInterval(() => {
          recSeconds++;
          const m = String(Math.floor(recSeconds / 60)).padStart(2, '0');
          const s = String(recSeconds % 60).padStart(2, '0');
          recTimer.textContent = `${m}:${s}`;
        }, 1000);
      } catch (err) {
        showToast('未能啟用麥克風權限，可改用下方「📁 選擇音檔」上傳手機錄音');
      }
    });

    inputUploadAudio.addEventListener('change', () => {
      const file = inputUploadAudio.files && inputUploadAudio.files[0];
      if (!file || !currentBook) return;
      const reader = new FileReader();
      reader.onload = async () => {
        await saveVoiceClip(currentBook.id, currentPage, reader.result);
        refreshRecordModalUI();
        showToast('🎵 已成功匯入本頁真人配音檔！');
        inputUploadAudio.value = '';
      };
      reader.readAsDataURL(file);
    });

    btnDeleteRec.addEventListener('click', async () => {
      if (!currentBook) return;
      try { recAudioPlayer.pause(); } catch (e) {}
      await deleteVoiceClip(currentBook.id, currentPage);
      refreshRecordModalUI();
      showToast('已刪除本頁錄音，改回系統語音朗讀');
    });

    // ==================== INIT ====================
    loadStorage();
    syncLanguageUI();
    renderHome();
    loadAllVoiceClips().then(() => {
      if (!currentBook) renderHome();
      else updateRecordButtonBadge();
    });

    if ('speechSynthesis' in window) {
      refreshVoices();
      window.speechSynthesis.onvoiceschanged = refreshVoices;
      setTimeout(refreshVoices, 350);
      setTimeout(refreshVoices, 1200);
    }
  </script>
</body>
</html>
