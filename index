    // ==================== VOICE ENGINE (HK CANTONESE + MANDARIN) ====================
    function normLang(l) { return (l || '').toLowerCase().replace(/_/g, '-'); }

    function isCantoneseVoice(v) {
      const lang = normLang(v.lang);
      const name = (v.name || '').toLowerCase();
      if (lang === 'zh-hk' || lang === 'yue-hk' || lang === 'yue-hant-hk' || lang === 'yue' || lang === 'zh-yue' || lang.startsWith('yue-') || lang.includes('-hk')) {
        return true;
      }
      return /cantonese|hong\s*kong|粵語|粤语|廣東話|广东话|香港|sinji|sin-ji|hiugaai|hiumaan|wanlung|tracy|danny/.test(name);
    }

    function isMandarinVoice(v) {
      if (isCantoneseVoice(v)) return false;
      const lang = normLang(v.lang);
      const name = (v.name || '').toLowerCase();
      return lang.startsWith('zh-tw') || lang.startsWith('zh-cn') || lang === 'zh' || lang.startsWith('cmn') || /mandarin|國語|普通話|中文|meijia|tingting|hsiaoyu|xiaoxiao|yunxi|yating|hanhan/.test(name);
    }

    function scoreCantoneseVoice(v) {
      const name = (v.name || '').toLowerCase();
      let score = 10;
      if (/natural|online|google|premium|enhanced|siri/.test(name)) score += 20;
      if (/hiugaai|hiumaan|sinji|sin-ji|google 粵語|google 粤语/.test(name)) score += 15;
      if (normLang(v.lang) === 'zh-hk' || normLang(v.lang) === 'yue-hk') score += 10;
      return score;
    }

    function getSelectedVoice(targetMode) {
      const voices = cachedVoices;
      if (manualVoiceURI) {
        const picked = voices.find(v => v.voiceURI === manualVoiceURI);
        if (picked) return picked;
      }
      if (targetMode === 'zh-HK') {
        const hkVoices = voices.filter(isCantoneseVoice).sort((a, b) => scoreCantoneseVoice(b) - scoreCantoneseVoice(a));
        return hkVoices[0] || null;
      } else {
        const twFirst = voices.filter(v => isMandarinVoice(v) && normLang(v.lang).startsWith('zh-tw'));
        if (twFirst.length) return twFirst[0];
        const anyMandarin = voices.filter(isMandarinVoice);
        return anyMandarin[0] || null;
      }
    }

