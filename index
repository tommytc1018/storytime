<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>寶貝成長有聲繪本館 — 親子故事書架</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap');

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      font-family: 'Noto Sans TC', 'Inter', 'PingFang HK', 'Microsoft JhengHei', sans-serif;
      background: radial-gradient(circle at top left, #FFF7EC 0%, #FDF0E6 48%, #F2F0FA 100%);
      color: #3B2F2F;
    }

    body.reader-mode {
      height: 100vh;
      overflow: hidden;
    }

    .book-shadow {
      box-shadow:
        0 20px 50px rgba(92, 61, 46, 0.14),
        0 4px 12px rgba(92, 61, 46, 0.07),
        inset 0 0 0 1px rgba(255, 255, 255, 0.85);
    }

    .card-shadow {
      box-shadow: 0 10px 28px rgba(107, 74, 52, 0.09);
    }

    .spine-shadow {
      background: linear-gradient(
        90deg,
        rgba(120, 82, 54, 0) 0%,
        rgba(120, 82, 54, 0.08) 45%,
        rgba(120, 82, 54, 0.16) 50%,
        rgba(120, 82, 54, 0.08) 55%,
        rgba(120, 82, 54, 0) 100%
      );
    }

    @keyframes gentleKenBurns {
      0% { transform: scale(1.00) translate(0px, 0px); }
      50% { transform: scale(1.045) translate(-4px, -3px); }
      100% { transform: scale(1.00) translate(0px, 0px); }
    }

    .animate-ken-burns { animation: gentleKenBurns 9s ease-in-out infinite; }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.85; }
      50% { transform: translateY(-9px) rotate(7deg); opacity: 1; }
    }

    @keyframes floatDelay {
      0%, 100% { transform: translateY(0px) scale(1); opacity: 0.72; }
      50% { transform: translateY(-12px) scale(1.1); opacity: 1; }
    }

    .sparkle-1 { animation: floatSlow 4.2s ease-in-out infinite; }
    .sparkle-2 { animation: floatDelay 5.1s ease-in-out infinite 0.8s; }

    @keyframes pageFadeIn {
      0% { opacity: 0; transform: translateX(16px) scale(0.988); }
      100% { opacity: 1; transform: translateX(0) scale(1); }
    }
    @keyframes pageFadeInBack {
      0% { opacity: 0; transform: translateX(-16px) scale(0.988); }
      100% { opacity: 1; transform: translateX(0) scale(1); }
    }
    .page-enter-next { animation: pageFadeIn 0.36s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
    .page-enter-prev { animation: pageFadeInBack 0.36s cubic-bezier(0.22, 1, 0.36, 1) forwards; }

    .paper-texture {
      background-color: #FFFDF9;
      background-image: radial-gradient(rgba(195, 160, 120, 0.12) 1px, transparent 0);
      background-size: 20px 20px;
    }

    .no-anim .animate-ken-burns,
    .no-anim .sparkle-1,
    .no-anim .sparkle-2 {
      animation: none !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ==================== HOME / BOOKSHELF VIEW ==================== -->
  <div id="homeView" class="flex-1 flex flex-col min-h-screen">
    <!-- Top Header -->
    <header class="sticky top-0 z-30 bg-white/85 backdrop-blur-md border-b border-amber-200/70 px-4 sm:px-8 py-3">
      <div class="max-w-6xl mx-auto flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white flex items-center justify-center text-xl shadow-sm shrink-0">📚</div>
          <div class="min-w-0">
            <h1 class="text-base sm:text-xl font-black text-amber-950 truncate">寶貝成長有聲繪本館</h1>
            <p class="text-[11px] sm:text-xs text-amber-800/80 truncate">爸爸媽媽專屬 · 廣東話／普通話一鍵播給小朋友聽</p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <!-- Global Language Toggle -->
          <div class="inline-flex rounded-full bg-amber-50 border border-amber-200 p-0.5 text-xs font-bold">
            <button id="homeLangHK" type="button" class="px-2.5 py-1 rounded-full bg-amber-500 text-white transition-colors">廣東話</button>
            <button id="homeLangTW" type="button" class="px-2.5 py-1 rounded-full text-amber-900 hover:bg-amber-100 transition-colors">普通話</button>
          </div>

          <button id="btnHomeVoice" type="button" title="語音設定" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold bg-white border border-amber-200 hover:bg-amber-50 text-amber-900 transition-all">
            <span>🎙️</span>
            <span class="hidden md:inline">語音</span>
          </button>

          <button id="btnOpenAddStory" type="button" class="inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition-all active:scale-95">
            <span>＋</span>
            <span>新增故事</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Bookshelf Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-8 py-6 sm:py-8 space-y-6">
      <!-- Welcome / Filter Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white/75 backdrop-blur-sm rounded-3xl p-4 sm:p-5 border border-amber-200/70 shadow-xs">
        <div class="flex flex-wrap items-center gap-2" id="categoryTabs" role="tablist" aria-label="故事分類">
          <!-- Rendered by JS -->
        </div>

        <div class="flex flex-wrap items-center gap-2 self-end sm:self-auto shrink-0">
          <button id="btnPlayAllBooks" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500 hover:bg-emerald-600 text-white shadow-xs transition-all active:scale-95">
            <span>🔁</span><span>連播全部故事</span>
          </button>
          <button id="btnExportLib" type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition-all">
            <span>📤</span><span>備份故事庫</span>
          </button>
          <label class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-amber-50 text-amber-900 border border-amber-200 cursor-pointer transition-all">
            <span>📥</span><span>匯入故事</span>
            <input id="inputImportLib" type="file" accept="application/json,.json" class="hidden" />
          </label>
        </div>
      </div>

      <!-- Story Cards Grid -->
      <section id="storyGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        <!-- Rendered by JS -->
      </section>
    </main>

    <!-- Subtle Footer -->
    <footer class="py-4 px-4 text-center text-xs text-amber-900/60">
      小貼士：在手機或 iPad 上點「加入主畫面」，就能像 App 一樣隨時開故事給小朋友聽！
    </footer>
  </div>

  <!-- ==================== STORYBOOK READER VIEW ==================== -->
  <div id="readerView" class="hidden flex-col h-screen w-screen overflow-hidden">
    <!-- Reader Top Bar -->
    <header class="flex-none px-3 sm:px-6 py-2.5 flex items-center justify-between gap-2 bg-white/85 backdrop-blur-md border-b border-amber-200/60 z-20">
      <div class="flex items-center gap-2 min-w-0">
        <button id="btnBackHome" type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-amber-100 hover:bg-amber-200 text-amber-950 transition-all active:scale-95 shrink-0">
          <span>←</span>
          <span>書架</span>
        </button>
        <h2 id="readerBookTitle" class="text-sm sm:text-base font-black text-amber-950 truncate"></h2>
        <span id="pageBadge" class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 shrink-0">封面</span>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Language Toggle -->
        <div class="inline-flex rounded-full bg-amber-50 border border-amber-200 p-0.5 text-xs font-bold">
          <button id="langHK" type="button" class="px-2.5 py-1 rounded-full bg-amber-500 text-white transition-colors">廣東話</button>
          <button id="langTW" type="button" class="px-2.5 py-1 rounded-full text-amber-900 hover:bg-amber-100 transition-colors">普通話</button>
        </div>

        <!-- Auto-Play Full Story Button (Made for Mom!) -->
        <button id="btnAutoPlay" type="button" title="自動朗讀並自動翻頁" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition-all active:scale-95">
          <span id="autoPlayIcon">▶️</span>
          <span id="autoPlayLabel">自動播放</span>
        </button>

        <!-- Speed Toggle -->
        <button id="btnSpeed" type="button" title="切換朗讀速度" class="hidden sm:inline-flex items-center px-2.5 py-1.5 rounded-full text-xs font-bold bg-white border border-amber-200 hover:bg-amber-50 text-amber-900 transition-all">
          🐢 慢速
        </button>

        <!-- Single Page Speak Button -->
        <button id="btnSpeak" type="button" title="朗讀這一頁" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-950 transition-all active:scale-95">
          <span id="speakIcon">🔊</span>
          <span id="speakLabel" class="hidden sm:inline">讀這頁</span>
        </button>

        <!-- Record / Upload Real Voice Button -->
        <button id="btnOpenRecord" type="button" title="為這一頁錄製爸媽真人聲或上傳 MP3" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold bg-rose-50 border border-rose-200 hover:bg-rose-100 text-rose-700 transition-all active:scale-95">
          <span id="recBtnIcon">🎙️</span>
          <span id="recBtnLabel" class="hidden sm:inline">爸媽錄音</span>
        </button>

        <!-- Voice Settings -->
        <button id="btnReaderVoice" type="button" title="語音設定" class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm bg-white border border-amber-200 hover:bg-amber-50 text-amber-900 transition-all">🎙️</button>

        <!-- Animation Toggle -->
        <button id="btnAnim" type="button" title="開關圖片微動畫" class="hidden sm:inline-flex items-center justify-center w-8 h-8 rounded-full text-sm bg-amber-50 border border-amber-200 hover:bg-amber-100 text-amber-900 transition-all">✨</button>
      </div>
    </header>

    <!-- Main 2-Page Spread -->
    <main class="flex-1 flex items-center justify-center p-2.5 sm:p-5 overflow-hidden relative">
      <div id="autoPlayBanner" class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-30 px-4 py-1.5 rounded-full bg-emerald-600/95 text-white text-xs font-bold shadow-md items-center gap-2 backdrop-blur-xs">
        <span class="inline-block w-2 h-2 rounded-full bg-white animate-pulse"></span>
        <span id="autoPlayBannerText">正在自動朗讀 · 讀完會自動翻下一頁</span>
      </div>
      <div id="bookFrame" class="w-full max-w-5xl h-full max-h-[620px] rounded-3xl book-shadow overflow-hidden relative flex flex-col md:flex-row bg-[#FFFDF9]">
        <!-- Rendered by JS -->
      </div>
    </main>

    <!-- Bottom Pagination Bar -->
    <footer class="flex-none px-4 sm:px-6 py-2.5 flex items-center justify-between gap-3 bg-white/85 backdrop-blur-md border-t border-amber-200/60 z-20">
      <button id="btnPrev" type="button" class="inline-flex items-center gap-1.5 px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-bold bg-white border border-amber-300 text-amber-900 hover:bg-amber-50 disabled:opacity-40 disabled:cursor-not-allowed shadow-sm transition-all active:scale-95">
        <span>←</span><span>上一頁</span>
      </button>

      <div id="pageDots" class="flex items-center gap-1.5 sm:gap-2" role="tablist" aria-label="頁碼導覽"></div>

      <button id="btnNext" type="button" class="inline-flex items-center gap-1.5 px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-bold bg-amber-500 hover:bg-amber-600 text-white disabled:opacity-40 disabled:cursor-not-allowed shadow-sm transition-all active:scale-95">
        <span id="nextLabel">翻開故事</span><span>→</span>
      </button>
    </footer>
  </div>

  <!-- ==================== VOICE SETTINGS MODAL ==================== -->
  <div id="voiceModal" class="fixed inset-0 bg-amber-950/40 backdrop-blur-xs hidden items-center justify-center p-4 z-50">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-amber-200 p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-black text-amber-950 flex items-center gap-2"><span>🎙️</span><span>語音朗讀設定（廣東話 / 普通話）</span></h3>
        <button id="btnCloseVoiceModal" type="button" class="w-8 h-8 rounded-full bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold">✕</button>
      </div>
      <div id="voiceDiagBox" class="rounded-2xl bg-amber-50 border border-amber-200 p-3 text-xs text-amber-900 leading-relaxed"></div>
      <div class="space-y-1.5">
        <label for="voiceSelect" class="block text-xs font-bold text-amber-900">選擇此裝置的語音：</label>
        <select id="voiceSelect" class="w-full rounded-xl border border-amber-300 bg-white px-3 py-2 text-xs sm:text-sm text-amber-950 focus:outline-none focus:ring-2 focus:ring-amber-400"></select>
      </div>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button id="btnTestVoice" type="button" class="px-4 py-2 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-bold shadow-sm transition-all active:scale-95">🔊 試聽廣東話</button>
        <button id="btnDoneVoiceModal" type="button" class="px-4 py-2 rounded-full bg-amber-100 hover:bg-amber-200 text-amber-950 text-xs sm:text-sm font-bold transition-all">完成</button>
      </div>
    </div>
  </div>

  <!-- ==================== RECORD / UPLOAD HUMAN VOICE MODAL ==================== -->
  <div id="recordModal" class="fixed inset-0 bg-amber-950/45 backdrop-blur-xs hidden items-center justify-center p-3 sm:p-5 z-50">
    <div class="w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-rose-200 overflow-hidden flex flex-col max-h-[90vh]">
      <div class="px-5 py-3.5 border-b border-rose-100 bg-rose-50/70 flex items-center justify-between">
        <h3 class="text-base font-black text-amber-950 flex items-center gap-2">
          <span>💖</span>
          <span id="recModalTitle">為本頁錄製真人廣東話</span>
        </h3>
        <button id="btnCloseRecModal" type="button" class="w-8 h-8 rounded-full bg-white hover:bg-rose-100 text-amber-900 font-bold">✕</button>
      </div>

      <div class="p-5 space-y-4 overflow-y-auto">
        <!-- Teleprompter for Mom / Dad -->
        <div class="rounded-2xl bg-amber-50 border border-amber-200 p-3.5 space-y-1.5">
          <div class="flex items-center justify-between text-xs font-bold text-amber-800">
            <span>📜 廣東話朗讀提詞（對著念就可以！）</span>
            <span id="recPageIndicator" class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-900"></span>
          </div>
          <p id="recTeleprompter" class="text-sm sm:text-base text-amber-950 leading-relaxed font-medium select-text"></p>
        </div>

        <!-- Mic Recorder Controls -->
        <div class="rounded-2xl border border-rose-200 bg-rose-50/40 p-4 flex flex-col items-center gap-3 text-center">
          <div class="flex items-center gap-3">
            <button id="btnToggleMicRec" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-rose-500 hover:bg-rose-600 text-white text-sm font-bold shadow-md transition-all active:scale-95">
              <span id="micRecIcon">🔴</span>
              <span id="micRecLabel">開始錄製爸媽聲音</span>
            </button>
            <span id="recTimer" class="hidden font-mono text-sm font-black text-rose-600 px-2.5 py-1 rounded-full bg-white border border-rose-200">00:00</span>
          </div>
          <p class="text-[11px] text-amber-800/80">錄完後自動儲存，播放故事與自動翻頁時會優先播放你們的真人聲音！</p>
        </div>

        <!-- Upload MP3 / Voice Memo -->
        <div class="rounded-2xl border border-amber-200 bg-white p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
          <div class="text-xs text-amber-900">
            <div class="font-bold">🎵 或上傳外部真人配音檔</div>
            <div class="text-[11px] text-amber-700/80">支援 MP3、M4A、WAV（例如手機語音備忘錄或 AI 粵語配音）</div>
          </div>
          <label class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-950 cursor-pointer shrink-0 transition-all">
            <span>📁 選擇音檔</span>
            <input id="inputUploadAudio" type="file" accept="audio/*" class="hidden" />
          </label>
        </div>

        <!-- Current Saved Recording Preview -->
        <div id="recPreviewBox" class="hidden rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-emerald-800">✅ 本頁已儲存真人配音</span>
            <button id="btnDeleteRec" type="button" class="text-xs font-bold text-rose-600 hover:underline">🗑️ 刪除（改回系統語音）</button>
          </div>
          <audio id="recAudioPlayer" controls class="w-full h-10"></audio>
        </div>
      </div>

      <div class="px-5 py-3 border-t border-rose-100 bg-rose-50/40 flex items-center justify-between">
        <span class="text-[11px] text-amber-800/75">💡 可用首頁「📤 備份故事庫」把錄音一起傳給太太</span>
        <button id="btnDoneRecModal" type="button" class="px-4 py-1.5 rounded-full bg-amber-500 hover:bg-amber-600 text-white text-xs sm:text-sm font-bold">完成</button>
      </div>
    </div>
  </div>

  <!-- ==================== ADD NEW STORY MODAL ==================== -->
  <div id="addStoryModal" class="fixed inset-0 bg-amber-950/45 backdrop-blur-xs hidden items-center justify-center p-3 sm:p-5 z-50">
    <div class="w-full max-w-2xl max-h-[90vh] bg-white rounded-3xl shadow-2xl border border-amber-200 flex flex-col overflow-hidden">
      <div class="px-5 py-4 border-b border-amber-100 flex items-center justify-between bg-amber-50/70">
        <h3 class="text-base sm:text-lg font-black text-amber-950 flex items-center gap-2"><span>✨</span><span>新增一本新故事到書架</span></h3>
        <button id="btnCloseAddModal" type="button" class="w-8 h-8 rounded-full bg-white hover:bg-amber-100 text-amber-900 font-bold">✕</button>
      </div>

      <form id="addStoryForm" class="flex-1 overflow-y-auto p-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-amber-900 mb-1">故事書名 *</label>
            <input id="newTitle" type="text" required placeholder="例如：早睡早起身體好！" class="w-full rounded-xl border border-amber-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-amber-900 mb-1">分類標籤</label>
            <select id="newCategory" class="w-full rounded-xl border border-amber-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-400">
              <option value="衛生習慣">衛生習慣</option>
              <option value="用餐習慣">用餐習慣</option>
              <option value="情緒管理">情緒管理</option>
              <option value="禮貌溝通">禮貌溝通</option>
              <option value="外出安全">外出安全</option>
              <option value="生活好習慣">生活好習慣</option>
              <option value="睡前故事">睡前故事</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-amber-900 mb-1">副標題／簡介</label>
            <input id="newSubtitle" type="text" placeholder="例如：給小朋友的睡前小繪本" class="w-full rounded-xl border border-amber-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-amber-900 mb-1">封面圖片（可選，上傳手機／電腦圖片）</label>
            <input id="newCoverFile" type="file" accept="image/*" class="w-full text-xs text-amber-900 file:mr-2 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-amber-100 file:text-amber-900 hover:file:bg-amber-200" />
          </div>
        </div>

        <div class="border-t border-amber-100 pt-3 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs sm:text-sm font-black text-amber-950">📖 故事內頁</span>
            <button id="btnAddPageRow" type="button" class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-950">＋ 加一頁</button>
          </div>
          <div id="newPagesContainer" class="space-y-3">
            <!-- Dynamic page editors -->
          </div>
        </div>
