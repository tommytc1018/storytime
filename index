    function openAudioDB() {
      return new Promise((resolve, reject) => {
        if (!('indexedDB' in window)) { reject(new Error('no idb')); return; }
        try {
          const req = indexedDB.open(AUDIO_DB_NAME, 1);
          req.onupgradeneeded = () => {
            const db = req.result;
            if (!db.objectStoreNames.contains(AUDIO_STORE_NAME)) {
              db.createObjectStore(AUDIO_STORE_NAME);
            }
          };
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        } catch (e) { reject(e); }
      });
    }

    async function loadAllVoiceClips() {
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readonly');
        const store = tx.objectStore(AUDIO_STORE_NAME);
        await new Promise((resolve) => {
          const req = store.openCursor();
          req.onsuccess = (e) => {
            const cursor = e.target.result;
            if (cursor) {
              voiceClipsCache[cursor.key] = cursor.value;
              cursor.continue();
            } else {
              resolve();
            }
          };
          req.onerror = () => resolve();
        });
      } catch (e) {}
    }

    async function saveVoiceClip(bookId, pageIdx, dataUrl) {
      const key = clipKey(bookId, pageIdx);
      voiceClipsCache[key] = dataUrl;
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readwrite');
        tx.objectStore(AUDIO_STORE_NAME).put(dataUrl, key);
      } catch (e) {}
    }

    async function deleteVoiceClip(bookId, pageIdx) {
      const key = clipKey(bookId, pageIdx);
      delete voiceClipsCache[key];
      try {
        const db = await openAudioDB();
        const tx = db.transaction(AUDIO_STORE_NAME, 'readwrite');
        tx.objectStore(AUDIO_STORE_NAME).delete(key);
      } catch (e) {}
    }

